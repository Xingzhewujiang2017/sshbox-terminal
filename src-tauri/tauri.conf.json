{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SSHBox",
  "version": "0.5.1",
  "identifier": "com.z.sshbox",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SSHBox",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "SSHBox",
    "copyright": "MIT License",
    "category": "DeveloperTool",
    "shortDescription": "SSH 终端 + 虚拟机实时监控",
    "longDescription": "类 MobaXterm 的 SSH 客户端：多标签终端、主机列表、系统凭据加密保存、主机密钥校验，右侧面板实时显示远程 Linux 的系统版本、配置与 CPU/内存/网络/磁盘状态。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese",
          "English"
        ]
      }
    }
  }
}